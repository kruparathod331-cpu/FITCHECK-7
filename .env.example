# FitCheck ATS Resume Builder - Backend Environment Configuration

# Database Connection (Defaults to PostgreSQL, falls back automatically to SQLite if PostgreSQL is unavailable)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/fitcheck_db
SQLITE_FALLBACK=true

# JWT Authentication
SECRET_KEY=fitcheck_super_secret_jwt_key_2026_dev_prod_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# File Upload Limit in Megabytes
MAX_UPLOAD_SIZE_MB=5
